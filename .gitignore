# Ignore local secrets, virtualenvs, caches, and generated audio.

# Python virtualenvs and local runtime
.venv/
venv/
env/
.python-version

# Compiled caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local privacy files
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
audio_cache.json

# Editor and OS files
.idea/
.vscode/
.DS_Store
*.swp
Thumbs.db

# Generated audio and media
*.mp3
*.m4a
*.wav
audio_files/
